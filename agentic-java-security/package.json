{
  "name": "agentic-java-security",
  "displayName": "Agentic Java Security Tester",
  "description": "Agentic extension that compiles, debugs, captures runtime state, and analyzes Java programs for potential security issues.",
  "version": "0.1.0",
  "publisher": "your-name-or-org",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onCommand:extension.autoBreakpoint",
    "onDebugResolve:java",
    "onLanguage:java",
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.autoBreakpoint",
        "title": "Run Java Security Test"
      }
    ],
    "debuggers": [
      {
        "type": "java",
        "label": "Java Debugger with State Capture",
        "program": "./out/extension.js",
        "languages": ["java"]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0"
  }
}

